# HEAD node (<hostname>, rank 0). Copy to ~/deepseek-v4/.env on <hostname>.
NODE_RANK=0
MASTER_ADDR=<HEAD_ROCE_IP>
MASTER_PORT=25000
VLLM_HOST_IP=<HEAD_ROCE_IP>

DS4_IMAGE=vllm-node-pr51959:latest
DS4_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
DS4_REVISION=9e165c30e2704aec5d9d593cce3eebd58bbef1cb
SERVED_MODEL_NAME=deepseek-v4-flash
VLLM_HOST=0.0.0.0
VLLM_PORT=8888

# Verified-up fabric on this cluster (…f0, not the template's …f1)
NCCL_IB_HCA=rocep1s0f0
NCCL_SOCKET_IFNAME=enp1s0f0np0
TP_SOCKET_IFNAME=enp1s0f0np0
GLOO_SOCKET_IFNAME=enp1s0f0np0

# Conservative first-boot profile; raise after reading real KV capacity from the log
MOE_BACKEND=auto
KV_CACHE_DTYPE=fp8_ds_mla
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=12
GPU_MEMORY_UTILIZATION=0.85
MTP_NUM_TOKENS=5

HF_CACHE=<HOME>/.cache/huggingface
HF_HUB_OFFLINE=1
HEADLESS=
VLLM_LOGGING_LEVEL=INFO
VLLM_USE_DEEP_GEMM=1
VLLM_MOE_USE_DEEP_GEMM=1
VLLM_USE_BREAKABLE_CUDAGRAPH=0
MAX_NUM_BATCHED_TOKENS=4096
MAX_CUDAGRAPH_CAPTURE_SIZE=72
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
